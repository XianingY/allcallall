# AllCallAll 生产环境合规配置模板 (Phase 1)
# 复制为 .env 后填入真实值。所有开关默认关闭，上线前必须逐项开启。
# 本文件不提交密钥；主密钥经 KMS 或环境变量注入。

# ── 传输安全 ──
SECURITY_REQUIRE_TLS=true

# ── 隐私合规 7 件套（仿微信「中转而非归档」）──
MESSAGE_RETENTION_ENABLED=true
MESSAGE_RETENTION_TEXT_TTL_HOURS=72
MESSAGE_RETENTION_MEDIA_TTL_HOURS=120

MESSAGE_ENCRYPTION_ENABLED=true
# 主密钥：优先 KMS（KMS_PROVIDER=cloud 时由 kms.RotatingProvider 注入），
# 否则使用下方 base64 静态密钥（经 secret manager 注入，勿落库）。
MESSAGE_ENCRYPTION_MASTER_KEY=
MESSAGE_ENCRYPTION_KEY_ID=prod-v1
KMS_PROVIDER=

MESSAGE_RECALL_ENABLED=true
MESSAGE_RECALL_WINDOW_MINUTES=2
MESSAGE_RECALL_ALLOW_ADMIN_OVERRIDE=true

SEARCH_INDEX_ENABLED=true
SEARCH_INDEX_BODY_SNIPPET_MAX_RUNES=64

CONTENT_MODERATION_ENABLED=true
CONTENT_MODERATION_KEYWORDS=违规词1,违规词2

# 以下为新增规范 flag（见 internal/compliance/ai_filing.go AssessPosture）
MESSAGE_ERASURE_ENABLED=true
REALNAME_VERIFICATION_ENABLED=true

# ── AI 生成内容标识 ──
AIGC_LABELING_ENABLED=true

# ── 经营资质 ──
ICP_LICENSE_NUMBER=京ICP备12345678号-1

# ── 限速（Phase 0 默认滑动窗口）──
RATE_LIMIT_SLIDING_WINDOW=true
GLOBAL_RATE_LIMIT=600
GLOBAL_RATE_WINDOW=1m

# ── 召回模式（Phase 优化 #202）──
RAG_CHUNK_SEARCH_MODE=hybrid
