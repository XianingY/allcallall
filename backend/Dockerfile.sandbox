FROM golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download || \
    (sleep 10 && go mod download) || \
    (sleep 15 && go mod download) || \
    go mod download
COPY . .
ARG TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} \
    go build -ldflags='-w -s' -o /out/sandbox-service ./cmd/sandbox-service

FROM aquasec/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c
COPY --from=build /out/sandbox-service /usr/local/bin/sandbox-service
USER 65532:65532
EXPOSE 8092
ENTRYPOINT ["/usr/local/bin/sandbox-service"]
