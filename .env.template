# ⚠️ LOCAL DEVELOPMENT ONLY — DO NOT USE THESE DEFAULTS IN PRODUCTION
# ===============================
# Agent & AI Engine Configuration
# ===============================

# 切换为真实的大模型引擎 (可选值: rules, openai_compatible)
AGENT_PROVIDER=openai_compatible

# 1. 主干大模型 (用于 Agent 逻辑规划与对话，比如配置 DeepSeek)
AGENT_OPENAI_BASE_URL=https://api.deepseek.com/v1
AGENT_OPENAI_API_KEY=sk-your-deepseek-key
AGENT_OPENAI_MODEL=deepseek-chat

# 2. 向量大模型 (用于 RAG 检索，独立配置。如果不配，会自动使用上面主干模型的配置)
AGENT_OPENAI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AGENT_OPENAI_EMBEDDING_API_KEY=sk-your-siliconflow-key
AGENT_OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
AGENT_OPENAI_EMBEDDING_DIMS=1024

# ===============================
# 本地开发与基础设施配置
# ===============================
# 注: 当您使用 `make run-backend` 在 Mac 本机启动代码时，代码无法像 Docker 内容器一样通过 "mysql" 名字解析到数据库。
# 因此，您必须在这里覆盖这些连接地址，让代码去连接您 Docker Compose 暴露在本地的端口。

# MySQL 连接。密码需要和本地 Docker Compose 初始化时的 MYSQL_PASSWORD 一致。
MYSQL_PASSWORD="allcallallpass" # local-dev only
MYSQL_ROOT_PASSWORD="rootpass" # local-dev only
DB_DSN="allcallall:allcallallpass@tcp(127.0.0.1:3306)/allcallall_db?parseTime=true&charset=utf8mb4&loc=Local"

# Redis 连接
REDIS_ADDR="127.0.0.1:6379"
REDIS_PASSWORD="redispass" # local-dev only

# Elasticsearch 连接 (提供向量检索功能)
ELASTICSEARCH_URL="http://127.0.0.1:9200"

# JWT 签名密钥 (随意填写一段复杂字符串)
JWT_SECRET="local-development-jwt-secret-key-12345" # local-dev only

# Agent platform secrets.
# OPENBAO_TOKEN: openssl rand -hex 32
# Generate the matching capability keypair with:
# ./scripts/development/generate-agent-capability-keypair.sh
OPENBAO_TOKEN=
MCP_CAPABILITY_ED25519_PRIVATE_KEY=
SANDBOX_CAPABILITY_ED25519_PUBLIC_KEY=
MCP_PLATFORM_ENABLED=true
SANDBOX_EXECUTION_ENABLED=true
SANDBOX_CONTROL_PLANE_URL=http://127.0.0.1:8092
SANDBOX_DB_DSN="allcallall:allcallallpass@tcp(127.0.0.1:3306)/allcallall_db?parseTime=true&charset=utf8mb4&loc=UTC"

# ===============================
# Web Frontend Configuration
# ===============================
VITE_APP_VERSION=0.1.0
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/api/v1/ws
VITE_REVENUECAT_PUBLIC_API_KEY=your_revenuecat_key

# ===============================
# Mobile App Configuration (Expo)
# ===============================
EXPO_PUBLIC_API_HTTP=http://127.0.0.1:8080
EXPO_PUBLIC_API_WS=ws://127.0.0.1:8080
EXPO_PUBLIC_FORCE_TLS=0
EXPO_PUBLIC_E2EE_MODE=auto
EXPO_PUBLIC_RESTRICTED_NETWORK=0
EXPO_PUBLIC_SIGNALING_TRANSPORT=auto
EXPO_PUBLIC_SIGNALING_SHAPING=0
EXPO_PUBLIC_APP_VERSION=0.1.0
EXPO_PUBLIC_WEB_APP_URL=http://localhost:5173
EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_key
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default

# ===============================
# Optional / Feature-Toggle Variables (commented out — uncomment to override)
# ===============================
# Speech transcription provider and related settings (e.g. openai_compatible).
# TRANSCRIPTION_PROVIDER=
# TRANSCRIPTION_OPENAI_API_KEY=
# TRANSCRIPTION_OPENAI_MODEL=

# WebRTC ICE servers (JSON array) used by the realtime signaling layer.
# WEBRTC_ICE_SERVERS_JSON=[]

# Agent sandbox runtime endpoint and capability token.
# SANDBOX_RUNTIME_BASE_URL=
# SANDBOX_CAPABILITY_TOKEN=
