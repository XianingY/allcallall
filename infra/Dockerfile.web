FROM node:20-alpine AS build

WORKDIR /src/mobile
COPY mobile/package.json mobile/package-lock.json ./
COPY mobile/patches ./patches
RUN npm ci
COPY mobile/ ./

ARG EXPO_PUBLIC_API_HTTP
ARG EXPO_PUBLIC_API_WS
ARG EXPO_PUBLIC_FORCE_TLS=1
ENV EXPO_PUBLIC_API_HTTP=${EXPO_PUBLIC_API_HTTP}
ENV EXPO_PUBLIC_API_WS=${EXPO_PUBLIC_API_WS}
ENV EXPO_PUBLIC_FORCE_TLS=${EXPO_PUBLIC_FORCE_TLS}
RUN npx expo export --platform web --output-dir dist

FROM nginx:1.27-alpine
COPY infra/nginx.tls.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/mobile/dist /usr/share/nginx/html
