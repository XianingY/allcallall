# Alertmanager routing for AllCallAll.
#
# This file is a TEMPLATE, not the config Alertmanager reads. Alertmanager
# does NOT expand environment variables - it supports neither {{ env "VAR" }}
# (that is Prometheus's Go template syntax) nor ${VAR}. The old version of
# this file used {{ env ... }}, which meant the webhook URL stayed the literal
# string and every alert was posted to a URL that cannot exist: rules fired,
# Alertmanager looked healthy, and nothing was ever delivered.
#
# The compose service renders this file at start-up and refuses to boot if a
# value is missing, so an unrendered placeholder can never reach Alertmanager.
#
# Placeholders: __ALERTMANAGER_WEBHOOK_URL__, __ALERTMANAGER_WEBHOOK_URL_CRITICAL__,
#               __ALERTMANAGER_WEBHOOK_URL_SECURITY__
#
# Verify delivery, not just "the alert fired":
#   curl -XPOST http://localhost:9093/api/v2/alerts -H 'Content-Type: application/json' \
#     -d '[{"labels":{"alertname":"SmokeTest","severity":"warning","instance":"manual"}}]'
#   # then confirm it arrived in the channel itself
global:
  resolve_timeout: 5m

route:
  receiver: default
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Critical pages go out fast and keep repeating until acknowledged.
    - receiver: critical
      matchers:
        - severity = "critical"
      group_wait: 10s
      repeat_interval: 1h
    - receiver: security
      matchers:
        - component = "auth"
      group_wait: 30s

receivers:
  # Any endpoint accepting Alertmanager's JSON payload works: a Slack incoming
  # webhook, PagerDuty events API, or your own relay. Email needs email_configs
  # with SMTP settings instead - see docs/observability.md.
  - name: default
    webhook_configs:
      - url: "__ALERTMANAGER_WEBHOOK_URL__"
        send_resolved: true

  - name: critical
    webhook_configs:
      - url: "__ALERTMANAGER_WEBHOOK_URL_CRITICAL__"
        send_resolved: true

  - name: security
    webhook_configs:
      - url: "__ALERTMANAGER_WEBHOOK_URL_SECURITY__"
        send_resolved: true

inhibit_rules:
  # A critical backlog makes the warning-level backlog alert noise.
  - source_matchers:
      - alertname = "OutboxBacklogCritical"
    target_matchers:
      - alertname = "OutboxBacklogHigh"
    equal: ["instance"]
  # If the backend is down entirely, its own sub-alerts are redundant.
  - source_matchers:
      - alertname = "BackendDown"
    target_matchers:
      - severity = "warning"
    equal: ["instance"]
