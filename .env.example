# ===========================================
# AllCallAll 项目环境变量配置示例
# ===========================================
# 
# 使用说明:
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际情况修改配置值
# 3. 不要提交 .env 文件到 Git
#

# 环境类型 (development/staging/production)
APP_ENV=production

# ===========================================
# 后端服务配置
# ===========================================

# JWT密钥 (至少32字符，建议使用随机生成)
# 生成方法: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_at_least_32_chars

# 邮件服务配置 (QQ邮箱授权码)
# 获取方法: QQ邮箱设置 -> 账户 -> POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务 -> 开启SMTP -> 获取授权码
MAIL_PASSWORD=your_qq_mail_authorization_code

# ===========================================
# 数据库配置
# ===========================================

# MySQL Root 用户密码
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# MySQL 应用用户密码
MYSQL_PASSWORD=your_mysql_password

# Redis 密码
REDIS_PASSWORD=your_redis_password

# ===========================================
# WebRTC配置
# ===========================================

# STUN/TURN服务器配置 (JSON格式)
# 默认使用Google公共STUN服务器
WEBRTC_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]}]

# 如需使用TURN服务器，格式如下:
# WEBRTC_ICE_SERVERS_JSON=[{"urls":["stun:stun.example.com:3478"]},{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"pass"}]
