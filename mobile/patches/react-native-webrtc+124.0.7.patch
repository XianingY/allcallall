+    private void onAudioRecordSamples(JavaAudioDeviceModule.AudioSamples audioSamples) {
+        if (audioSamples == null) {
+            return;
+        }
+
+        final byte[] data = audioSamples.getData();
+        if (data == null || data.length == 0) {
+            return;
+        }
+
+        final int sampleRate = audioSamples.getSampleRate();
+        final int channels = audioSamples.getChannelCount();
+
+        final byte[] chunk;
+        synchronized (audioCaptureLock) {
+            if (!audioCaptureEnabled) {
+                return;
+            }
+
+            if (audioCaptureSampleRate != sampleRate || audioCaptureChannels != channels) {
+                audioCaptureSampleRate = sampleRate;
+                audioCaptureChannels = channels;
+                audioCaptureLen = 0;
+                audioCaptureBuffer = new byte[0];
+            }
+
+            // PCM16 bytes.
+            final int chunkBytes = Math.max(1, (sampleRate * channels * 2 * audioCaptureChunkMs) / 1000);
+            final int needed = audioCaptureLen + data.length;
+            if (needed > audioCaptureBuffer.length) {
+                int newCap = Math.max(needed, Math.max(chunkBytes, audioCaptureBuffer.length * 2));
+                audioCaptureBuffer = Arrays.copyOf(audioCaptureBuffer, newCap);
+            }
+            System.arraycopy(data, 0, audioCaptureBuffer, audioCaptureLen, data.length);
+            audioCaptureLen += data.length;
+
+            if (audioCaptureLen < chunkBytes) {
+                return;
+            }
+
+            chunk = Arrays.copyOfRange(audioCaptureBuffer, 0, chunkBytes);
+            audioCaptureLen -= chunkBytes;
+            if (audioCaptureLen > 0) {
+                System.arraycopy(audioCaptureBuffer, chunkBytes, audioCaptureBuffer, 0, audioCaptureLen);
+            }
+        }
+
+        try {
+            String b64 = Base64.encodeToString(chunk, Base64.NO_WRAP);
+            WritableMap params = Arguments.createMap();
+            params.putString("pcm16Base64", b64);
+            params.putInt("sampleRate", sampleRate);
+            params.putInt("channels", channels);
+            params.putDouble("timestampMs", (double) System.currentTimeMillis());
+            sendEvent("webrtcAudioChunk", params);
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to emit webrtcAudioChunk", e);
+        }
+    }
