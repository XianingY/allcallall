{
  "name": "allcallall-mobile",
  "version": "0.1.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:dev-client": "expo start --dev-client",
    "start:dev-client:lan": "expo start --dev-client --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:smoke": "node scripts/web-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios --platform android",
    "test": "npm run test:runners && npm run test:unit && npm run test:jest",
    "test:runners": "node scripts/check-test-coverage.mjs",
    "test:unit": "tsx --test src/app/__tests__/linking.test.ts src/utils/linking.test.ts src/services/chatRealtimeCursor.test.ts src/services/conversationRealtimeReducer.test.ts src/services/roomMediaMapping.test.ts src/services/roomRemoteStreamRegistry.test.ts src/services/roomRealtimeReducer.test.ts src/context/signalingRtcUtils.test.ts src/screens/mcpPlatformUtils.test.ts src/store/useSubtitleStore.test.ts src/components/loadViewState.test.ts src/components/submitGuard.test.ts src/hooks/useVersionGate.test.ts test/launchActionGuards.test.ts test/downloadFileName.test.ts ../packages/shared/validation.test.ts ../packages/shared/format.test.ts",
    "test:jest": "jest",
    "lint": "eslint ."
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "src/components/loadViewState.test.ts",
      "src/components/submitGuard.test.ts",
      "src/context/signalingRtcUtils.test.ts",
      "src/hooks/useVersionGate.test.ts",
      "src/app/__tests__/linking.test.ts",
      "src/screens/mcpPlatformUtils.test.ts",
      "src/services/chatRealtimeCursor.test.ts",
      "src/services/conversationRealtimeReducer.test.ts",
      "src/services/roomMediaMapping.test.ts",
      "src/services/roomRealtimeReducer.test.ts",
      "src/services/roomRemoteStreamRegistry.test.ts",
      "src/store/useSubtitleStore.test.ts",
      "src/utils/linking.test.ts"
    ],
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/src/$1",
      "^expo/virtual/env$": "<rootDir>/jest-shims/expo-virtual-env.js"
    }
  },
  "dependencies": {
    "@allcallall/api-types": "*",
    "@allcallall/shared": "*",
    "@expo/metro-runtime": "~57.0.16",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "axios": "^1.18.1",
    "expo": "^57.0.26",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-keep-awake": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "mitt": "^3.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.16",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-purchases": "^10.12.0",
    "react-native-purchases-ui": "^10.12.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "124.0.7",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "event-target-shim": "^6.0.2",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "picomatch": "^4.0.4",
    "playwright": "^1.60.0",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.22.4",
    "typescript": "~7.0.2"
  }
}
