{
  "name": "allcallall-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:api": "openapi-typescript ../docs/api/openapi.yaml -o ../packages/api-types/schema.d.ts",
    "contract:check": "node ../scripts/web/openapi-contract-check.mjs",
    "bundle:budget": "node ../scripts/web/bundle-budget.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@allcallall/api-types": "*",
    "@allcallall/shared": "*",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-tabs": "1.1.3",
    "@revenuecat/purchases-js": "1.46.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^9.2.6",
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.53.0",
    "openapi-fetch": "^0.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.4.24",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.21.1",
    "msw": "^3.0.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
