{
  "name": "allcallall-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:api": "openapi-typescript ../docs/api/openapi.yaml -o ../packages/api-types/schema.d.ts",
    "contract:check": "node ../scripts/web/openapi-contract-check.mjs",
    "bundle:budget": "node ../scripts/web/bundle-budget.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@allcallall/api-types": "*",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-tabs": "1.1.3",
    "@revenuecat/purchases-js": "^1.46.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "i18next": "^25.8.13",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^6.30.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.11",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.12.10",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "4.62.2",
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  }
}
